{
  "name": "dsh-vdesktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Win32 virtual desktops for DSH: launch, screenshot and drive GUI apps without touching the user's screen, and keep working while the screen is locked.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "browser.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "sidecar/target/release/dshv.exe"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "inject": [
    "tools"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "ws": "^8.22.0"
  }
}
